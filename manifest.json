{
  "manifest_version": 3,
  "name": "펄스 Pulse",
  "version": "2.4.0",
  "description": "크랙 작품의 대화·좋아요·정산 예상을 날마다 쌓아서 추이로 보여 줘요.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "펄스",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "dashboard.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://crack.wrtn.ai/*",
    "https://crack-api.wrtn.ai/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "crack_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}